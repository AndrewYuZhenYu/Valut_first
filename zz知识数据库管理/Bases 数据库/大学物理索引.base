formulas:
  status: ""
views:
  - type: table
    name: 视图
    filters:
      and:
        - file.inFolder("大学物理")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.mtime
        direction: DESC
      - property: file.name
        direction: DESC
  - type: table
    name: 视图 2
